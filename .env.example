# Copy to .env.local (gitignored).
#
# Local dev: leave both unset to use the local SQLite file at data/simulator.db.
# Set them to point local dev at your Turso database instead.
#
# Vercel: these are injected by the Vercel ↔ Turso integration — don't set them by hand there.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
